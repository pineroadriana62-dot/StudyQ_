PORT=3000
NODE_ENV=development
# URL de conexión PostgreSQL de Supabase (usa la URL directa o el pooler).
DATABASE_URL=postgresql://postgres:tu_contrasena@db.tu-proyecto.supabase.co:5432/postgres
# Clave privada para proteger el acceso a la aplicación (mínimo 12 caracteres).
APP_PASSWORD=cambia-esta-clave-por-una-segura


